    "draft.github.sukoyaka-dopeness.dimension-assessment": {
      "specVersion": "0.2.0",
      "dimensions": [
        {
          "id": "lighthouse.restoration-role",
          "name": "修復における役割",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "記述された役割なし",
          "highLabel": "物語の中心となる役割",
          "description": "このDatasetに描かれた物語全体を通じて、灯台の修復においてEntityに記述された役割がどの程度中心的かを評価します。Datasetに役割が記されている場合、人、灯台、設備、資料、組織を対象にできます。0は明示的な最低評価であり、未評価を意味しません。5は中心的な役割を表します。"
        },
        {
          "id": "lighthouse.community-service",
          "name": "港と地域での継続利用への貢献",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "記述された貢献なし",
          "highLabel": "中心的な貢献",
          "description": "物語全体を通じて、Entityに記述された仕事や機能が、灯台の港での利用と地域への貢献を続けることをどの程度支えるかを評価します。修復に役割を持つこと自体とは異なり、結果への貢献を扱います。0は明示的な最低評価であり、未評価ではありません。5は記述上、中心的な貢献を表します。"
        },
        {
          "id": "lighthouse.role-expertise",
          "name": "役割に関する専門性の描写",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "役割に関する専門性の描写なし",
          "highLabel": "役割における専門性が明確に示される",
          "description": "物語全体を通じて、各人物が本人に記述された役割において専門性をどの程度明確に示しているかを評価します。異なる職業の難しさや価値を比べる尺度ではありません。0は、このDatasetで役割に関する専門性が描かれていないという明示的な評価であり、現実の能力がないことや未評価を意味しません。5は専門性が中心的かつ明確に示される状態です。"
        },
        {
          "id": "lighthouse.historical-stewardship",
          "name": "歴史知識と記録資料",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "歴史に関する資源・貢献の記述なし",
          "highLabel": "歴史に関する中心的な資源・貢献",
          "description": "物語全体を通じて、灯台や港の歴史に関する知識・記録について、Entityが記述上の情報源、保管先、発見の場、または管理主体としてどの程度中心的かを評価します。その関係が記述されている場合に限り適用します。0は明示的な最低評価であり、未評価ではありません。5は歴史知識や記録において中心的な役割を表します。"
        },
        {
          "id": "lighthouse.asset-readiness",
          "name": "記述された用途への稼働準備",
          "min": 0,
          "max": 5,
          "integerOnly": true,
          "lowLabel": "記述された用途への準備が示されていない",
          "highLabel": "記述された用途への準備が明確に示される",
          "description": "物語の結末として記述された、修復後の灯台設備が用途に使える状態かを評価します。対象は灯台と灯台システムに限り、現物検査や時系列評価ではありません。0は明示的な最低評価であり、Assessmentの欠如を意味しません。5は記述された用途への準備が明確であることを表します。"
        }
      ],
